          rank: 'Bronze V', history: [], totalWalls: 0, totalTurns: 0,
          sumPointsVictories: 0, opponentEloSum: 0, opponentCount: 0,
          xp: 0, equippedTitle: 'Recruta', ownedSkins: ['classic'],
