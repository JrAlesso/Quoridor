    function minimaxExpert(pos, pH, pV, walls, depth, alpha, beta, maximizing, iaIdx, startTime, timeLimit) {
      var key = hashState(pos, pH, pV);
      if (transpositionTable.has(key)) {
        var stored = transpositionTable.get(key);
