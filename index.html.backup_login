<!DOCTYPE html>
<html lang="pt-BR">
<head>
<link rel="stylesheet" href="style.css">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Quoridor</title>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
  



</head>
<body>
  <!-- TELA DE LOGIN -->
  <div id="login-screen" class="screen active">
    <div id="particulas-container" style="position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0"></div>
    <h1 style="position:relative;z-index:1">QUORIDOR</h1>
    <div class="sub" style="position:relative;z-index:1">Construa. Bloqueie. Vença.</div>
    <form id="login-form" style="position:relative;z-index:1">
      <input type="text" id="login-username" placeholder="Nome de usuário" required autocomplete="username">
      <input type="password" id="login-password" placeholder="Senha" required autocomplete="current-password">
      <input type="password" id="login-confirm" placeholder="Confirmar senha" style="display:none" autocomplete="new-password">
      <div id="login-error"></div>
      <button type="submit" class="btn-primary" id="login-btn">ENTRAR</button>
    </form>
    <button type="button" class="btn-primary" id="btn-guest" style="position:relative;z-index:1;width:100%;max-width:340px;margin-top:10px;background:rgba(255,215,140,0.12);color:#f0e6d3;border:1px solid rgba(255,215,140,0.25)">JOGAR COMO CONVIDADO</button>
    <div class="toggle-link" id="toggle-login" style="position:relative;z-index:1">Não tem conta? Cadastre-se</div>
    <div id="login-dica" style="position:relative;z-index:1;margin-top:18px;font-size:12px;color:#b8a99a;text-align:center;max-width:320px">Dica: Paredes bem colocadas valem mais que pressa.</div>
  </div>
  <!-- TELA DE MODOS -->
  <div id="mode-screen" class="screen"><div class="header"><div class="user-info" id="user-info-profile"><div class="avatar" id="user-avatar">J</div>
    <div><div class="name" id="user-name">Jogador</div><div class="badge" id="user-badge">● ONLINE</div></div></div>
    <div class="user-level" id="user-level">Nível 1</div></div><div class="rank-area" id="rank-area"> <div class="rank-row"><span class="rank-title">PATENTE</span><span class="rank-badge" id="rank-badge">Bronze V</span></div>
    <div class="rank-row"><span class="rank-pointers" id="rank-points">0 pts</span><span class="rank-pointers"> <button class="rank-indicator" id="rank-indicator-btn">Próx: Bronze IV</button></span></div>
    <div class="rank-progress"> <div class="fill" id="rank-progress-fill" style="width:0%"></div></div> <div class="rank-hint" id="rank-hint">Histórico</div></div> <div class="stats-row">
    <div class="stat-card"> <div class="value" id="stat-games-mode">0</div><div class="label">Partidas</div></div> <div class="stat-card"> <div class="value" id="stat-wins-mode">0</div><div class="label">Vitórias</div></div> <div class="stat-card"> <div class="value" id="stat-streak">0</div><div class="label">Sequência</div></div> </div>
    <div class="modos"> <div class="modo-btn" id="btn-online"><span class="icon">🌐</span><div class="info"><div class="title">Jogar Online</div><div class="desc">Partidas ranqueadas</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-vs-ia"><span class="icon">⚙</span><div class="info"><div class="title">Contra o Computador</div><div class="desc">Um jogador</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-2p"><span class="icon">⚔</span><div class="info"><div class="title">Dois Jogadores</div><div class="desc">Mesmo dispositivo</div></div><span class="arrow">›</span></div> <div class="modo-btn" id="btn-moderacao"><span class="icon">🛡</span><div class="info"><div class="title">Moderação</div><div class="desc">Staff e segurança</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-ranking" style="opacity:0.5"><span class="icon">🏆</span><div class="info"><div class="title">Classificação</div><div class="desc">Em breve</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-titulos"><span class="icon">🎖</span><div class="info"><div class="title">Títulos</div><div class="desc"></div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-medalhas"><span class="icon">🏅</span><div class="info"><div class="title">Medalhas</div><div class="desc"></div></div><span class="arrow">›</span></div> <div class="modo-btn" id="btn-trofeus"><span class="icon">🏆</span><div class="info"><div class="title">Troféus</div><div class="desc">Em breve</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-amigos"><span class="icon">👥</span><div class="info"><div class="title">Amigos</div>
    <div class="modo-btn" id="btn-chat"><span class="icon">💬</span><div class="info"><div class="title">Chat</div><div class="desc">Global, privado e guilda</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-guilda"><span class="icon">🛡️</span><div class="info"><div class="title">Guilda</div><div class="desc">Em breve</div></div><span class="arrow">›</span></div><div class="desc">Em breve</div></div><span class="arrow">›</span></div>
    <div class="modo-btn" id="btn-skins"><span class="icon">🎨</span><div class="info"><div class="title">Skins</div><div class="desc">Personalize seus peões</div></div><span class="arrow">›</span></div></div>
    <div class="daily"><div class="left"><span class="icon">🎁</span><div class="text"><strong>Recompensa diária</strong><br>+200 pontos</div></div><button class="btn-claim" id="btn-claim">Coletar</button></div>
  </div>
  <!-- TELA DO JOGO -->
  <div id="game-screen" class="screen"><div id="app"><div id="p2-controls"><button id="btnH2"><div class="wall-icon-h"></div>Horizontal</button><button id="btnV2"><div class="wall-icon-v"></div>Vertical</button></div><div id="hud-wrapper"><div id="info"><div class="p-info" id="p1"><span class="nome" id="p1-nome">Player 1</span><div class="paredes-wrap" id="pips1"></div></div><div id="timer-display" class="vez1"><span id="timer-player-name">PLAYER 1</span><span class="tempo" id="timerDisplay">30</span></div><div class="p-info" id="p2"><span class="nome" id="nomeJ2">Player 2</span><div class="paredes-wrap" id="pips2"></div></div></div><div id="placar"><span class="p1">◇ <span id="placar-p1">Player 1</span>: <span id="score1">0</span></span><span class="p2"><span id="placar-p2">Player 2</span>: <span id="score2">0</span> ◇</span></div><div id="rodada-info">Rodada 1 de 1</div></div><div id="canvas-container"><canvas id="board"></canvas></div><div id="status">Player 1 começa!</div><div id="ia-thinking"><span>IA PENSANDO</span><div class="dot-pulse"><span></span><span></span><span></span></div></div><div id="btns-parede"><button id="btnH"><div class="wall-icon-h"></div> Horizontal</button><button id="btnV"><div class="wall-icon-v"></div> Vertical</button></div><div id="menu-container"><button id="menu-toggle">MENU <span class="arrow">▼</span></button><div id="menu-dropdown"> <div class="row"><button class="btn-item undo" id="btnUndo">DESFAZER</button><button class="btn-item reset" id="btnReset"> NOVO</button></div><div class="row"><button class="btn-item stats" id="btnStats">ESTAT</button><button class="btn-item menu-back" id="btnBackMenu">MENU</button></div></div></div></div></div>
  <!-- OVERLAYS (profile, history, win, config, stats, titles, skins, medals, ranks, inspect, sala) -->
  <div id="win-overlay"><div id="win-card"><div id="win-message">Jogador Venceu!</div><button id="btn-close-win">FECHAR</button></div></div>
  <div id="confetti-container"></div>
  <div id="stats-overlay"><div id="stats-card"><h2>ESTATÍSTICAS</h2><div id="stats-content"></div><button id="btn-close-stats">FECHAR</button></div></div>
  <div id="profile-overlay"><div id="profile-card"><h2>PERFIL <button class="close-btn" id="profile-close">✕</button></h2><div class="profile-list" id="profile-list"></div><button id="btn-close-profile">FECHAR</button></div></div>
  <div id="history-overlay"><div id="history-card"><h2>HISTÓRICO <button class="close-btn" id="history-close">✕</button></h2><div class="history-list" id="history-list"></div></div></div>
  <div id="titles-overlay"><div id="titles-card"><h2>TÍTULOS <button class="close-btn" id="titles-close">✕</button></h2><input type="text" class="title-search" id="title-search" placeholder="Buscar título..."><div class="titles-tabs"><button class="tab-btn active" data-tab="vitorias">Vitórias</button><button class="tab-btn" data-tab="partidas">Partidas</button><button class="tab-btn" data-tab="sequencia">Sequência</button><button class="tab-btn" data-tab="nivel">Nível</button><button class="tab-btn" data-tab="2p">2 Jogadores</button><button class="tab-btn" data-tab="vsia">Vs IA</button><button class="tab-btn" data-tab="classificacao">Classificação</button><button class="tab-btn" data-tab="outros">Outros</button></div><div class="titles-list" id="titles-list"></div><button id="btn-close-titles">FECHAR</button></div></div>
  <div id="skins-overlay"><div id="skins-card"><h2>SKINS <button class="close-btn" id="skins-close">✕</button></h2><div id="skins-balance"></div><div class="skins-tabs" id="skins-tabs"><button class="skin-tab active" data-tab="simples">Simples</button><button class="skin-tab" data-tab="lendarias">Lendárias</button><button class="skin-tab" data-tab="raras">Raras</button><button class="skin-tab" data-tab="eventos">Eventos</button><button class="skin-tab" data-tab="paises">Países</button></div><div class="skins-list" id="skins-list"></div><button id="btn-close-skins">FECHAR</button></div></div>
  <div id="inspect-overlay"><div id="inspect-card"><h2>INSPECIONAR <button class="close-btn" id="inspect-close">✕</button></h2><div id="inspect-content"></div><button id="btn-close-inspect">FECHAR</button></div></div>
  <div id="ranks-overlay"><div id="ranks-card"><h2>PATENTES <button class="close-btn" id="ranks-close">✕</button></h2><div id="ranks-progress"></div><div class="ranks-list" id="ranks-list"></div><button id="btn-close-ranks">FECHAR</button></div></div>
  <div id="medals-overlay"><div id="medals-card"><h2>MEDALHAS <button class="close-btn" id="medals-close">✕</button></h2><div class="medals-list" id="medals-list"></div><button id="btn-close-medals">FECHAR</button></div></div>
  <div id="sala-overlay"><div id="sala-card"><h2>JOGAR ONLINE <button class="close-btn" id="sala-close">✕</button></h2><div id="sala-content">
<input type="text" id="sala-nome-input" class="sala-input" placeholder="Nome da partida" maxlength="24">
<input type="text" id="sala-senha-input" class="sala-input" placeholder="Senha (opcional)">
<button id="btn-criar-sala" style="width:100%;padding:12px;margin-bottom:12px;border:none;border-radius:12px;background:linear-gradient(135deg,#d4a373,#b8860b);color:#1a1410;font-weight:800;cursor:pointer">CRIAR SALA</button>
<div class="sala-status" id="sala-status">Salas abertas aparecem abaixo</div>
<div class="sala-lista" id="sala-lista"></div>
<button id="btn-close-sala">FECHAR</button>
</div></div></div>
  <div id="config-overlay"><div id="config-card"><h2>CONFIGURAÇÕES</h2><div class="config-group"><label>TEMPO</label><div class="options" id="time-options"><button data-time="30">30s</button><button data-time="45">45s</button><button data-time="60">60s</button></div></div><div class="config-group"><label>RODADAS</label><div class="options" id="rounds-options"><button data-rounds="1">1</button><button data-rounds="3">3</button><button data-rounds="5">5</button></div></div><div class="config-group" id="nivel-config" style="display:none;"><label>DIFICULDADE</label><div class="options" id="nivel-options"><button data-nivel="facil">FÁCIL</button><button data-nivel="medio">MÉDIO</button><button data-nivel="dificil">DIFÍCIL</button><button data-nivel="expert">EXPERT</button></div></div><div class="config-group" id="names-config" style="display:none;"><label>NOMES</label><input type="text" id="p1-name-input" placeholder="Player 1" maxlength="12" readonly><input type="text" id="p2-name-input" placeholder="Player 2" maxlength="12"></div><button id="btn-start-game">INICIAR</button><button id="btn-voltar">VOLTAR</button></div></div>
  
  <!-- ===== CORREÇÃO: Botões de fechar o overlay da sala ===== -->
  

  <div id="chat-overlay"><div id="chat-card"><h2>💬 CHAT <button class="close-btn" id="chat-close">✕</button></h2>
    <div class="chat-tabs">
      <button class="chat-tab active" data-tab="global">Global</button>
      <button class="chat-tab" data-tab="privado">Privado</button>
      <button class="chat-tab" data-tab="guilda">Guilda</button>
      <button class="chat-tab" data-tab="info">Informação</button>
    </div>
    <div id="chat-content" class="chat-content">
      <div id="chat-global" class="chat-pane active">
        <div class="chat-messages" id="global-messages"><div class="chat-msg system">Bem-vindo ao chat global!</div></div>
        <input type="text" id="global-input" class="chat-input" placeholder="Digite...">
      </div>
      <div id="chat-privado" class="chat-pane">
        <div class="chat-messages" id="privado-messages"><div class="chat-msg system">Selecione um amigo para conversar.</div></div>
        <input type="text" id="privado-input" class="chat-input" placeholder="Digite...">
      </div>
      <div id="chat-guilda" class="chat-pane">
        <div class="chat-messages" id="guilda-messages"><div class="chat-msg system">Entre em uma guilda para conversar.</div></div>
        <input type="text" id="guilda-input" class="chat-input" placeholder="Digite...">
      </div>
      <div id="chat-info" class="chat-pane">
        <div class="chat-messages"><div class="chat-msg system">Informações do jogo, regras e avisos.</div></div>
      </div>
    </div>
    <button id="btn-close-chat">FECHAR</button>
  </div></div>

  <div id="guilda-overlay"><div id="guilda-card"><h2>🛡️ GUILDA <button class="close-btn" id="guilda-close">✕</button></h2>
    <div style="color:#b8a99a;text-align:center;padding:40px 0;">Em breve! Estamos preparando algo incrível.</div>
    <button id="btn-close-guilda">FECHAR</button>
  </div></div>







<script src="script.js"></script>

<script id="LOGIN_FIX_INLINE">
(function(){
  var SESSION_KEY="quoridor_session_user";
  function setS(u){ try{ localStorage.setItem(SESSION_KEY,u||""); }catch(e){} }
  var conf=document.getElementById("login-confirm");
  if(conf) conf.style.display="none";
  var btn=document.getElementById("login-btn");
  if(btn) btn.textContent="ENTRAR";
  var isLogin=true;
  var tog=document.getElementById("toggle-login");
  if(tog){
    tog.textContent="Não tem conta? Cadastre-se";
    tog.addEventListener("click", function(){
      isLogin=!isLogin;
      if(btn) btn.textContent=isLogin?"ENTRAR":"CRIAR CONTA";
      tog.textContent=isLogin?"Não tem conta? Cadastre-se":"Já tem conta? Faça login";
      if(conf) conf.style.display=isLogin?"none":"block";
    });
  }
  function go(u){
    try{
      currentUser=u; setS(u);
      var n=document.getElementById("user-name"); if(n) n.textContent=u;
      var a=document.getElementById("user-avatar"); if(a) a.textContent=(u[0]||"J").toUpperCase();
      if(typeof goToModeScreen==="function") goToModeScreen(u);
      else if(typeof showScreen==="function") showScreen("mode-screen");
    }catch(e){ if(typeof showScreen==="function") showScreen("mode-screen"); }
  }
  var form=document.getElementById("login-form");
  if(form){
    form.addEventListener("submit", function(e){
      e.preventDefault(); e.stopPropagation();
      var err=document.getElementById("login-error");
      var u=(document.getElementById("login-username").value||"").trim();
      var p=document.getElementById("login-password").value||"";
      var c=conf?conf.value:"";
      if(!u||!p){ if(err) err.textContent="Preencha usuário e senha"; return; }
      try{
        if(isLogin){
          if(typeof loginUser==="function"&&loginUser(u,p)){ if(err) err.textContent=""; go(u); }
          else if(err) err.textContent="Usuário ou senha inválidos";
        }else{
          if(p!==c){ if(err) err.textContent="Senhas não coincidem"; return; }
          if(typeof createUser==="function"&&createUser(u,p)){ loginUser(u,p); if(err) err.textContent=""; go(u); }
          else if(err) err.textContent="Usuário já existe";
        }
      }catch(ex){ if(err) err.textContent="Erro: "+ex.message; }
    }, true);
  }
  var g=document.getElementById("btn-guest");
  if(!g){
    g=document.createElement("button");
    g.id="btn-guest"; g.type="button"; g.textContent="JOGAR COMO CONVIDADO";
    g.className="btn-primary";
    g.style.cssText="width:100%;max-width:340px;margin:10px auto;display:block;padding:14px;border-radius:14px;border:1px solid rgba(255,215,140,0.25);background:rgba(255,215,140,0.12);color:#f0e6d3;font-weight:800";
    var ls=document.getElementById("login-screen");
    if(ls) ls.appendChild(g);
  }
  g.addEventListener("click", function(){
    var name="Convidado"+Math.floor(Math.random()*900+100);
    try{ if(typeof createUser==="function") createUser(name,"guest"); if(typeof loginUser==="function") loginUser(name,"guest"); }catch(e){}
    go(name);
  });
  console.log("LOGIN_FIX_INLINE OK");
})();
</script>
</body>
</html>
